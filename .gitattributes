* text=auto eol=lf
*.go text eol=lf
*.sh text eol=lf
*.md text eol=lf

# Vendored Go modules and generated lockfiles are not reviewed line by line.
# -text skips line-ending normalization: go mod vendor copies upstream
# content verbatim, and a few modules ship CRLF. Without -text every
# vendor refresh rewrites those files to LF and breaks the vendor-check
# drift gate.
vendor/** linguist-vendored -text
go.sum -diff
*.lock -diff

# The mise lockfiles hold the toolchain download digests; a version bump's
# diff is the only place a reviewer sees them change. The bare basename
# matches both ./mise.lock and .config/mise/mise.lock.
mise.lock diff

# Read by the resolve-rebase-conflicts skill through
# `git check-attr rebase-resolve`. apm regenerates this lockfile wholesale.
apm.lock.yaml rebase-resolve=regenerate

# Generated by `mise run bundle-openapi` from api/openapi/; re-running it is the answer.
api/openapi.bundle.yaml linguist-generated rebase-resolve=regenerate

# Written by the skill token tooling; re-running it is the answer.
**/skills/*/tokens.json rebase-resolve=regenerate

# The resolve-rebase-conflicts skill shows the conflict marker shape in its
# own text, and marker-scan.sh reads this attribute to skip the copy.
.claude/skills/resolve-rebase-conflicts/SKILL.md conflict-markers=documented
.agents/skills/resolve-rebase-conflicts/SKILL.md conflict-markers=documented

# Keep additions from both branches in the shared vocabulary lists.
/.cspell-words.txt merge=union
/.vale/config/vocabularies/project/accept.txt merge=union

# Architecture exports are regenerated from docs/workspace.dsl.
docs/workspace.json linguist-generated rebase-resolve=regenerate
docs/diagrams/structurizr-* linguist-generated rebase-resolve=regenerate
docs/diagrams/structurizr.sha256 linguist-generated rebase-resolve=regenerate

# D2 renders are regenerated from the .d2 source beside them.
*.d2.svg linguist-generated rebase-resolve=regenerate
*.d2.png linguist-generated rebase-resolve=regenerate
*.d2.sha256 linguist-generated rebase-resolve=regenerate
