@startuml
title <size:24>Deployment View: Topology cluster</size>\n<size:24>Service nodes and independent launch nodes on the private overlay.</size>

set separator none
left to right direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

skinparam {
  nodesep 80
  ranksep 160
}

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element
  .Element-RWxlbWVudA== {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Topology
  .Element-RWxlbWVudCxUb3BvbG9neQ== {
    BackgroundColor: #e8f1fa;
    LineColor: #315b7d;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #122b44;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Element,Deployment Node
  .DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU= {
    BackgroundColor: #f5f7fa;
    LineColor: #536b7e;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "User tailnet boundary\n<size:16>[Deployment Node: User tailnet]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologycluster.Usertailnetboundary {
  rectangle "==Attached user tailnet\n<size:16>[Software System]</size>\n\nUser-controlled private connectivity; separate from the cluster overlay." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Topologycluster.Usertailnetboundary.Attachedusertailnet_1
}

rectangle "External ingress boundary\n<size:16>[Deployment Node: Gateway node]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologycluster.Externalingressboundary {
  rectangle "==External ingress gateway\n<size:16>[Container: Application proxy]</size>\n\nAccepts public and attached-tailnet application requests; never routes packets between tailnets and the cluster." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Topologycluster.Externalingressboundary.Externalingressgateway_1
}

rectangle "Cluster overlay boundary\n<size:16>[Deployment Node: Private overlay]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologycluster.Clusteroverlayboundary {
  rectangle "==Private overlay reachability\n<size:16>[Infrastructure Node: Tailscale tsnet]</size>\n\nEach cluster node retains a static map of stable nodes. Ingress rules admit only the gateway and named peers." <<Element-RWxlbWVudA==>> as Topologycluster.Clusteroverlayboundary.Privateoverlayreachability
  rectangle "Control plane boundary\n<size:16>[Deployment Node: Control plane]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologycluster.Clusteroverlayboundary.Controlplaneboundary {
    rectangle "API service node\n<size:16>[Deployment Node: tsnet node]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologycluster.Clusteroverlayboundary.Controlplaneboundary.APIservicenode {
      rectangle "==API server and web dashboard\n<size:16>[Container: Application service]</size>\n\nAuthorizes operations and serves the dashboard from its own origin." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Topologycluster.Clusteroverlayboundary.Controlplaneboundary.APIservicenode.APIserverandwebdashboard_1
    }

    rectangle "Preview service node\n<size:16>[Deployment Node: tsnet node]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologycluster.Clusteroverlayboundary.Controlplaneboundary.Previewservicenode {
      rectangle "==Preview server\n<size:16>[Container: Application service]</size>\n\nDials workload proxies over the overlay; published-port listener binding remains open." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Topologycluster.Clusteroverlayboundary.Controlplaneboundary.Previewservicenode.Previewserver_1
    }

    rectangle "MCP service node\n<size:16>[Deployment Node: tsnet node]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologycluster.Clusteroverlayboundary.Controlplaneboundary.MCPservicenode {
      rectangle "==MCP gateway\n<size:16>[Container: Application service]</size>\n\nChecks launch tool grants and keeps upstream credentials outside guests." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Topologycluster.Clusteroverlayboundary.Controlplaneboundary.MCPservicenode.MCPgateway_1
    }

    rectangle "Static origin node\n<size:16>[Deployment Node: tsnet node]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologycluster.Clusteroverlayboundary.Controlplaneboundary.Staticoriginnode {
      rectangle "==Static origin\n<size:16>[Container: Caddy]</size>\n\nServes static site and single-page app deploys from local copies of their files; keeps no cache." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Topologycluster.Clusteroverlayboundary.Controlplaneboundary.Staticoriginnode.Staticorigin_1
    }

    rectangle "Coordination node\n<size:16>[Deployment Node: Coordination service]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologycluster.Clusteroverlayboundary.Controlplaneboundary.Coordinationnode {
      rectangle "==Overlay coordination\n<size:16>[Container: Headscale]</size>\n\nAn afakt interface fronts isolated Headscale coordination; cluster nodes retain a static map of stable nodes." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Topologycluster.Clusteroverlayboundary.Controlplaneboundary.Coordinationnode.Overlaycoordination_1
    }

    rectangle "Relay node\n<size:16>[Deployment Node: Relay service]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologycluster.Clusteroverlayboundary.Controlplaneboundary.Relaynode {
      rectangle "==Overlay relay\n<size:16>[Container: Overlay transport]</size>\n\nCarries encrypted overlay traffic when a relay path is needed." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Topologycluster.Clusteroverlayboundary.Controlplaneboundary.Relaynode.Overlayrelay_1
    }

  }

  rectangle "Workload host boundary\n<size:16>[Deployment Node: Workload host]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologycluster.Clusteroverlayboundary.Workloadhostboundary {
    rectangle "Host node\n<size:16>[Deployment Node: tsnet node]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologycluster.Clusteroverlayboundary.Workloadhostboundary.Hostnode {
      rectangle "==Host-level connectivity\n<size:16>[Container: Host connectivity service]</size>\n\nHost authorization for agent and cluster services; connection mechanism undecided; optional user tailnet attachment." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Topologycluster.Clusteroverlayboundary.Workloadhostboundary.Hostnode.Hostlevelconnectivity_1
    }

    rectangle "Agent launch boundary\n<size:16>[Deployment Node: Launch isolation]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologycluster.Clusteroverlayboundary.Workloadhostboundary.Agentlaunchboundary {
      rectangle "==Workload proxy\n<size:16>[Container: Network proxy]</size>\n\nCarries workload traffic in both directions; own overlay node and launch X.509-SVID; asks the mediator to decide each connection." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Topologycluster.Clusteroverlayboundary.Workloadhostboundary.Agentlaunchboundary.Workloadproxy_1
    }

  }

  rectangle "Another workload host boundary\n<size:16>[Deployment Node: Workload host]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologycluster.Clusteroverlayboundary.Anotherworkloadhostboundary {
    rectangle "Another host node\n<size:16>[Deployment Node: tsnet node]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologycluster.Clusteroverlayboundary.Anotherworkloadhostboundary.Anotherhostnode {
      rectangle "==Host-level connectivity\n<size:16>[Container: Host connectivity service]</size>\n\nHost authorization for agent and cluster services; connection mechanism undecided; optional user tailnet attachment." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Topologycluster.Clusteroverlayboundary.Anotherworkloadhostboundary.Anotherhostnode.Hostlevelconnectivity_1
    }

    rectangle "Another launch boundary\n<size:16>[Deployment Node: Launch isolation]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologycluster.Clusteroverlayboundary.Anotherworkloadhostboundary.Anotherlaunchboundary {
      rectangle "==Destination workload proxy\n<size:16>[Container: Network proxy]</size>\n\nCarries destination workload traffic under mediator decisions; own overlay node and launch X.509-SVID." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Topologycluster.Clusteroverlayboundary.Anotherworkloadhostboundary.Anotherlaunchboundary.Destinationworkloadproxy_1
    }

  }

}

Topologycluster.Usertailnetboundary.Attachedusertailnet_1 --> Topologycluster.Externalingressboundary.Externalingressgateway_1 <<Relationship-UmVsYXRpb25zaGlw>> : "Delivers application requests\n<size:16>[Transport Layer Security]</size>"
Topologycluster.Usertailnetboundary.Attachedusertailnet_1 --> Topologycluster.Clusteroverlayboundary.Workloadhostboundary.Hostnode.Hostlevelconnectivity_1 <<Relationship-UmVsYXRpb25zaGlw>> : "Optional host attachment; application access only\n<size:16>[User tailnet]</size>"
Topologycluster.Usertailnetboundary.Attachedusertailnet_1 --> Topologycluster.Clusteroverlayboundary.Anotherworkloadhostboundary.Anotherhostnode.Hostlevelconnectivity_1 <<Relationship-UmVsYXRpb25zaGlw>> : "Optional host attachment; application access only\n<size:16>[User tailnet]</size>"
Topologycluster.Externalingressboundary.Externalingressgateway_1 --> Topologycluster.Clusteroverlayboundary.Privateoverlayreachability <<Relationship-UmVsYXRpb25zaGlw>> : "Authenticated app requests\n<size:16>[Overlay access]</size>"
Topologycluster.Clusteroverlayboundary.Controlplaneboundary.APIservicenode.APIserverandwebdashboard_1 --> Topologycluster.Clusteroverlayboundary.Privateoverlayreachability <<Relationship-UmVsYXRpb25zaGlw>> : "Service identity\n<size:16>[Overlay membership]</size>"
Topologycluster.Clusteroverlayboundary.Controlplaneboundary.Previewservicenode.Previewserver_1 --> Topologycluster.Clusteroverlayboundary.Privateoverlayreachability <<Relationship-UmVsYXRpb25zaGlw>> : "Service identity\n<size:16>[Overlay membership]</size>"
Topologycluster.Clusteroverlayboundary.Controlplaneboundary.MCPservicenode.MCPgateway_1 --> Topologycluster.Clusteroverlayboundary.Privateoverlayreachability <<Relationship-UmVsYXRpb25zaGlw>> : "Service identity\n<size:16>[Overlay membership]</size>"
Topologycluster.Clusteroverlayboundary.Controlplaneboundary.Staticoriginnode.Staticorigin_1 --> Topologycluster.Clusteroverlayboundary.Privateoverlayreachability <<Relationship-UmVsYXRpb25zaGlw>> : "Service identity\n<size:16>[Overlay membership]</size>"
Topologycluster.Clusteroverlayboundary.Controlplaneboundary.Coordinationnode.Overlaycoordination_1 --> Topologycluster.Clusteroverlayboundary.Privateoverlayreachability <<Relationship-UmVsYXRpb25zaGlw>> : "Node coordination\n<size:16>[afakt interface]</size>"
Topologycluster.Clusteroverlayboundary.Controlplaneboundary.Relaynode.Overlayrelay_1 --> Topologycluster.Clusteroverlayboundary.Privateoverlayreachability <<Relationship-UmVsYXRpb25zaGlw>> : "Encrypted transport\n<size:16>[Relay path]</size>"
Topologycluster.Clusteroverlayboundary.Workloadhostboundary.Hostnode.Hostlevelconnectivity_1 --> Topologycluster.Clusteroverlayboundary.Privateoverlayreachability <<Relationship-UmVsYXRpb25zaGlw>> : "Host identity\n<size:16>[Overlay membership]</size>"
Topologycluster.Clusteroverlayboundary.Anotherworkloadhostboundary.Anotherhostnode.Hostlevelconnectivity_1 --> Topologycluster.Clusteroverlayboundary.Privateoverlayreachability <<Relationship-UmVsYXRpb25zaGlw>> : "Host identity\n<size:16>[Overlay membership]</size>"
Topologycluster.Clusteroverlayboundary.Workloadhostboundary.Agentlaunchboundary.Workloadproxy_1 --> Topologycluster.Clusteroverlayboundary.Privateoverlayreachability <<Relationship-UmVsYXRpb25zaGlw>> : "Launch identity\n<size:16>[Coarse service access]</size>"
Topologycluster.Clusteroverlayboundary.Anotherworkloadhostboundary.Anotherlaunchboundary.Destinationworkloadproxy_1 --> Topologycluster.Clusteroverlayboundary.Privateoverlayreachability <<Relationship-UmVsYXRpb25zaGlw>> : "Destination launch identity\n<size:16>[Coarse service access]</size>"

@enduml
