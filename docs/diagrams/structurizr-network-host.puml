@startuml
title <size:24>Deployment View: Topology host</size>\n<size:24>Host management, operator access and independent launch trust boundaries.</size>

set separator none
top to bottom direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

skinparam {
  nodesep 80
  ranksep 160
}

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Topology
  .Element-RWxlbWVudCxUb3BvbG9neQ== {
    BackgroundColor: #e8f1fa;
    LineColor: #315b7d;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #122b44;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Element,Deployment Node
  .DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU= {
    BackgroundColor: #f5f7fa;
    LineColor: #536b7e;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "Workload host trust boundary\n<size:16>[Deployment Node: Workload host]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologyhost.Workloadhosttrustboundary {
  rectangle "Dedicated worker user\n<size:16>[Deployment Node: User boundary]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologyhost.Workloadhosttrustboundary.Dedicatedworkeruser {
    rectangle "==Workload host worker\n<size:16>[Container: Host service]</size>\n\nObserves workload execution as a dedicated non-root user; workload lifecycle ownership remains open." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Topologyhost.Workloadhosttrustboundary.Dedicatedworkeruser.Workloadhostworker_1
  }

  rectangle "Privileged setup boundary\n<size:16>[Deployment Node: Privilege boundary]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologyhost.Workloadhosttrustboundary.Privilegedsetupboundary {
    rectangle "==Privileged helper\n<size:16>[Container: Host privilege boundary]</size>\n\nPerforms narrowly authorized setup and launch operations; caller binding is undecided." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Topologyhost.Workloadhosttrustboundary.Privilegedsetupboundary.Privilegedhelper_1
  }

  rectangle "==Host name resolver\n<size:16>[Container: Domain Name System]</size>\n\nResolves names under *.afakt.internal for host clients." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Topologyhost.Workloadhosttrustboundary.Hostnameresolver_1
  rectangle "Operator access boundary\n<size:16>[Deployment Node: Host service]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologyhost.Workloadhosttrustboundary.Operatoraccessboundary {
    rectangle "==Host access boundary\n<size:16>[Container: Access mechanism undecided]</size>\n\nHost-level authorization for services, previews and ports; local caller and connection mechanisms undecided." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Topologyhost.Workloadhosttrustboundary.Operatoraccessboundary.Hostaccessboundary_1
    rectangle "==Host-level connectivity\n<size:16>[Container: Host connectivity service]</size>\n\nHost authorization for agent and cluster services; connection mechanism undecided; optional user tailnet attachment." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Topologyhost.Workloadhosttrustboundary.Operatoraccessboundary.Hostlevelconnectivity_1
  }

  rectangle "Agent launch A\n<size:16>[Deployment Node: Launch boundary]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologyhost.Workloadhosttrustboundary.AgentlaunchA {
    rectangle "Guest A\n<size:16>[Deployment Node: Dedicated agent user in host mode]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologyhost.Workloadhosttrustboundary.AgentlaunchA.GuestA {
      rectangle "==Guest context\n<size:16>[Container: Workload provider confinement]</size>\n\nUntrusted harness, relay and loopback listeners; no overlay membership or workload keys." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Topologyhost.Workloadhosttrustboundary.AgentlaunchA.GuestA.Guestcontext_1
    }

    rectangle "Mediator A\n<size:16>[Deployment Node: Local confinement; user undecided]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologyhost.Workloadhosttrustboundary.AgentlaunchA.MediatorA {
      rectangle "==Workload proxy mediator\n<size:16>[Container: Local policy enforcement]</size>\n\nDecides every inbound and outbound connection and stamps identity; never carries traffic." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Topologyhost.Workloadhosttrustboundary.AgentlaunchA.MediatorA.Workloadproxymediator_1
    }

    rectangle "Workload proxy A\n<size:16>[Deployment Node: tsnet node; user undecided]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologyhost.Workloadhosttrustboundary.AgentlaunchA.WorkloadproxyA {
      rectangle "==Workload proxy\n<size:16>[Container: Network proxy]</size>\n\nCarries workload traffic in both directions; own overlay node and launch X.509-SVID; asks the mediator to decide each connection." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Topologyhost.Workloadhosttrustboundary.AgentlaunchA.WorkloadproxyA.Workloadproxy_1
    }

  }

  rectangle "Agent launch B\n<size:16>[Deployment Node: Launch boundary]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologyhost.Workloadhosttrustboundary.AgentlaunchB {
    rectangle "Guest B\n<size:16>[Deployment Node: Dedicated agent user in host mode]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologyhost.Workloadhosttrustboundary.AgentlaunchB.GuestB {
      rectangle "==Destination guest\n<size:16>[Container: Workload provider confinement]</size>\n\nUntrusted harness and published loopback listener; no overlay membership or workload keys." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Topologyhost.Workloadhosttrustboundary.AgentlaunchB.GuestB.Destinationguest_1
    }

    rectangle "Mediator B\n<size:16>[Deployment Node: Local confinement; user undecided]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologyhost.Workloadhosttrustboundary.AgentlaunchB.MediatorB {
      rectangle "==Destination mediator\n<size:16>[Container: Local policy enforcement]</size>\n\nChecks the source grant and current destination launch before listener access; no independent network." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Topologyhost.Workloadhosttrustboundary.AgentlaunchB.MediatorB.Destinationmediator_1
    }

    rectangle "Workload proxy B\n<size:16>[Deployment Node: tsnet node; user undecided]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologyhost.Workloadhosttrustboundary.AgentlaunchB.WorkloadproxyB {
      rectangle "==Destination workload proxy\n<size:16>[Container: Network proxy]</size>\n\nCarries destination workload traffic under mediator decisions; own overlay node and launch X.509-SVID." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Topologyhost.Workloadhosttrustboundary.AgentlaunchB.WorkloadproxyB.Destinationworkloadproxy_1
    }

  }

}

Topologyhost.Workloadhosttrustboundary.Dedicatedworkeruser.Workloadhostworker_1 --> Topologyhost.Workloadhosttrustboundary.Privilegedsetupboundary.Privilegedhelper_1 <<Relationship-UmVsYXRpb25zaGlw>> : "Requests authorized setup and launch operations\n<size:16>[Authenticated local control]</size>"
Topologyhost.Workloadhosttrustboundary.Dedicatedworkeruser.Workloadhostworker_1 --> Topologyhost.Workloadhosttrustboundary.Hostnameresolver_1 <<Relationship-UmVsYXRpb25zaGlw>> : "Requires host name resolution\n<size:16>[Local control]</size>"
Topologyhost.Workloadhosttrustboundary.Dedicatedworkeruser.Workloadhostworker_1 --> Topologyhost.Workloadhosttrustboundary.Operatoraccessboundary.Hostlevelconnectivity_1 <<Relationship-UmVsYXRpb25zaGlw>> : "Sends host management requests\n<size:16>[Local channel]</size>"
Topologyhost.Workloadhosttrustboundary.Operatoraccessboundary.Hostaccessboundary_1 --> Topologyhost.Workloadhosttrustboundary.Operatoraccessboundary.Hostlevelconnectivity_1 <<Relationship-UmVsYXRpb25zaGlw>> : "Uses host-level authorization\n<size:16>[Connection mechanism undecided]</size>"
Topologyhost.Workloadhosttrustboundary.AgentlaunchA.GuestA.Guestcontext_1 --> Topologyhost.Workloadhosttrustboundary.AgentlaunchA.WorkloadproxyA.Workloadproxy_1 <<Relationship-UmVsYXRpb25zaGlw>> : "Sends workload traffic including DNS, TCP, UDP and QUIC\n<size:16>[Private workload link]</size>"
Topologyhost.Workloadhosttrustboundary.AgentlaunchA.MediatorA.Workloadproxymediator_1 --> Topologyhost.Workloadhosttrustboundary.AgentlaunchA.WorkloadproxyA.Workloadproxy_1 <<Relationship-UmVsYXRpb25zaGlw>> : "Returns connection decision and stamped launch identity\n<size:16>[Local channel]</size>"
Topologyhost.Workloadhosttrustboundary.AgentlaunchA.WorkloadproxyA.Workloadproxy_1 --> Topologyhost.Workloadhosttrustboundary.AgentlaunchB.WorkloadproxyB.Destinationworkloadproxy_1 <<Relationship-UmVsYXRpb25zaGlw>> : "Dials directly; both mediators check the connection\n<size:16>[SPIFFE mutual TLS over overlay]</size>"
Topologyhost.Workloadhosttrustboundary.AgentlaunchB.GuestB.Destinationguest_1 --> Topologyhost.Workloadhosttrustboundary.AgentlaunchB.WorkloadproxyB.Destinationworkloadproxy_1 <<Relationship-UmVsYXRpb25zaGlw>> : "Sends destination workload traffic\n<size:16>[Private workload link]</size>"
Topologyhost.Workloadhosttrustboundary.AgentlaunchB.MediatorB.Destinationmediator_1 --> Topologyhost.Workloadhosttrustboundary.AgentlaunchB.WorkloadproxyB.Destinationworkloadproxy_1 <<Relationship-UmVsYXRpb25zaGlw>> : "Returns destination connection decision\n<size:16>[Local channel]</size>"

@enduml
