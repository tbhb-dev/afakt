@startuml
title <size:24>Dynamic View: afakt</size>\n<size:24>Direct overlay connection checked by both mediators.</size>

set separator none
top to bottom direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

skinparam {
  nodesep 80
  ranksep 160
}

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Topology
  .Element-RWxlbWVudCxUb3BvbG9neQ== {
    BackgroundColor: #e8f1fa;
    LineColor: #315b7d;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #122b44;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // afakt
  .Boundary-YWZha3Q= {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Destination launch guest boundary
  .Group-RGVzdGluYXRpb24gbGF1bmNoIGd1ZXN0IGJvdW5kYXJ5 {
    BackgroundColor: #ffffff;
    LineColor: #536b7e;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Destination launch mediation boundary
  .Group-RGVzdGluYXRpb24gbGF1bmNoIG1lZGlhdGlvbiBib3VuZGFyeQ== {
    BackgroundColor: #ffffff;
    LineColor: #536b7e;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Destination launch network boundary
  .Group-RGVzdGluYXRpb24gbGF1bmNoIG5ldHdvcmsgYm91bmRhcnk= {
    BackgroundColor: #ffffff;
    LineColor: #536b7e;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Launch guest boundary
  .Group-TGF1bmNoIGd1ZXN0IGJvdW5kYXJ5 {
    BackgroundColor: #ffffff;
    LineColor: #536b7e;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Launch mediation boundary
  .Group-TGF1bmNoIG1lZGlhdGlvbiBib3VuZGFyeQ== {
    BackgroundColor: #ffffff;
    LineColor: #536b7e;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Launch workload proxy boundary
  .Group-TGF1bmNoIHdvcmtsb2FkIHByb3h5IGJvdW5kYXJ5 {
    BackgroundColor: #ffffff;
    LineColor: #536b7e;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "afakt\n<size:16>[Software System]</size>" <<Boundary-YWZha3Q=>> {
  rectangle "Destination launch guest boundary" <<Group-RGVzdGluYXRpb24gbGF1bmNoIGd1ZXN0IGJvdW5kYXJ5>> as group20 {
    rectangle "==Destination guest\n<size:16>[Container: Provider confinement]</size>\n\nUntrusted harness and published loopback listener; no overlay membership or workload keys." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.Destinationguest
  }

  rectangle "Destination launch mediation boundary" <<Group-RGVzdGluYXRpb24gbGF1bmNoIG1lZGlhdGlvbiBib3VuZGFyeQ==>> as group21 {
    rectangle "==Destination mediator\n<size:16>[Container: Local policy enforcement]</size>\n\nChecks the source grant and current destination launch before listener access; no independent network." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.Destinationmediator
  }

  rectangle "Destination launch network boundary" <<Group-RGVzdGluYXRpb24gbGF1bmNoIG5ldHdvcmsgYm91bmRhcnk=>> as group22 {
    rectangle "==Destination workload proxy\n<size:16>[Container: Network proxy]</size>\n\nCarries destination workload traffic under mediator decisions; own overlay node and launch X.509-SVID." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.Destinationworkloadproxy
  }

  rectangle "Launch guest boundary" <<Group-TGF1bmNoIGd1ZXN0IGJvdW5kYXJ5>> as group23 {
    rectangle "==Guest context\n<size:16>[Container: Provider confinement]</size>\n\nUntrusted harness, relay and loopback listeners; no overlay membership or workload keys." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.Guestcontext
  }

  rectangle "Launch mediation boundary" <<Group-TGF1bmNoIG1lZGlhdGlvbiBib3VuZGFyeQ==>> as group24 {
    rectangle "==Workload proxy mediator\n<size:16>[Container: Local policy enforcement]</size>\n\nDecides every inbound and outbound connection and stamps identity; never carries traffic." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.Workloadproxymediator
  }

  rectangle "Launch workload proxy boundary" <<Group-TGF1bmNoIHdvcmtsb2FkIHByb3h5IGJvdW5kYXJ5>> as group25 {
    rectangle "==Workload proxy\n<size:16>[Container: Network proxy]</size>\n\nCarries workload traffic in both directions; own overlay node and launch X.509-SVID; asks the mediator to decide each connection." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.Workloadproxy
  }

}

afakt.Guestcontext --> afakt.Workloadproxy <<Relationship-UmVsYXRpb25zaGlw>> : "1: Source launch requests published destination\n<size:16>[Private workload link]</size>"
afakt.Workloadproxy --> afakt.Workloadproxymediator <<Relationship-UmVsYXRpb25zaGlw>> : "2: Request egress decision\n<size:16>[Local channel]</size>"
afakt.Workloadproxymediator --> afakt.Workloadproxy <<Relationship-UmVsYXRpb25zaGlw>> : "3: Source policy permits destination name and port\n<size:16>[Local channel]</size>"
afakt.Workloadproxy --> afakt.Destinationworkloadproxy <<Relationship-UmVsYXRpb25zaGlw>> : "4: Direct overlay connection with mutual SPIFFE authentication\n<size:16>[SPIFFE mutual TLS over overlay]</size>"
afakt.Destinationworkloadproxy --> afakt.Destinationmediator <<Relationship-UmVsYXRpb25zaGlw>> : "5: Authenticated source launch and destination grant\n<size:16>[Local channel]</size>"
afakt.Destinationmediator --> afakt.Destinationworkloadproxy <<Relationship-UmVsYXRpb25zaGlw>> : "6: Return ingress decision\n<size:16>[Local channel]</size>"
afakt.Destinationworkloadproxy --> afakt.Destinationguest <<Relationship-UmVsYXRpb25zaGlw>> : "7: Permitted ingress; listener binding open (OQ-PORT-14)\n<size:16>[Private workload link]</size>"

@enduml
