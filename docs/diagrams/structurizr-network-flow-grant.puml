@startuml
title <size:24>Dynamic View: afakt</size>\n<size:24>Logical grant flow; direct overlay versus agent hub transport is undecided.</size>

set separator none
top to bottom direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

skinparam {
  nodesep 80
  ranksep 160
}

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Topology
  .Element-RWxlbWVudCxUb3BvbG9neQ== {
    BackgroundColor: #e8f1fa;
    LineColor: #315b7d;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #122b44;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Relationship,Undecided
  .Relationship-UmVsYXRpb25zaGlwLFVuZGVjaWRlZA== {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #8a5a00;
    FontColor: #8a5a00;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // afakt
  .Boundary-YWZha3Q= {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Destination launch guest boundary
  .Group-RGVzdGluYXRpb24gbGF1bmNoIGd1ZXN0IGJvdW5kYXJ5 {
    BackgroundColor: #ffffff;
    LineColor: #536b7e;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Destination launch mediation boundary
  .Group-RGVzdGluYXRpb24gbGF1bmNoIG1lZGlhdGlvbiBib3VuZGFyeQ== {
    BackgroundColor: #ffffff;
    LineColor: #536b7e;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Destination launch network boundary
  .Group-RGVzdGluYXRpb24gbGF1bmNoIG5ldHdvcmsgYm91bmRhcnk= {
    BackgroundColor: #ffffff;
    LineColor: #536b7e;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Launch agent proxy boundary
  .Group-TGF1bmNoIGFnZW50IHByb3h5IGJvdW5kYXJ5 {
    BackgroundColor: #ffffff;
    LineColor: #536b7e;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Launch guest boundary
  .Group-TGF1bmNoIGd1ZXN0IGJvdW5kYXJ5 {
    BackgroundColor: #ffffff;
    LineColor: #536b7e;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Launch mediation boundary
  .Group-TGF1bmNoIG1lZGlhdGlvbiBib3VuZGFyeQ== {
    BackgroundColor: #ffffff;
    LineColor: #536b7e;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "afakt\n<size:16>[Software System]</size>" <<Boundary-YWZha3Q=>> {
  rectangle "Destination launch guest boundary" <<Group-RGVzdGluYXRpb24gbGF1bmNoIGd1ZXN0IGJvdW5kYXJ5>> as group18 {
    rectangle "==Destination guest\n<size:16>[Container: Provider confinement]</size>\n\nUntrusted workload and published loopback listener; no overlay membership or workload keys." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.Destinationguest
  }

  rectangle "Destination launch mediation boundary" <<Group-RGVzdGluYXRpb24gbGF1bmNoIG1lZGlhdGlvbiBib3VuZGFyeQ==>> as group19 {
    rectangle "==Destination mediator\n<size:16>[Container: Local policy enforcement]</size>\n\nChecks the source grant and current destination launch before listener access; no independent network." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.Destinationmediator
  }

  rectangle "Destination launch network boundary" <<Group-RGVzdGluYXRpb24gbGF1bmNoIG5ldHdvcmsgYm91bmRhcnk=>> as group20 {
    rectangle "==Destination agent proxy\n<size:16>[Container: Tailscale tsnet]</size>\n\nIndependent overlay node, hub connection and destination launch X.509-SVID." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.Destinationagentproxy
  }

  rectangle "Launch agent proxy boundary" <<Group-TGF1bmNoIGFnZW50IHByb3h5IGJvdW5kYXJ5>> as group21 {
    rectangle "==Agent proxy\n<size:16>[Container: Tailscale tsnet]</size>\n\nOwn overlay node, hub connection and launch X.509-SVID; only launch component opening connections off the host." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.Agentproxy
  }

  rectangle "Launch guest boundary" <<Group-TGF1bmNoIGd1ZXN0IGJvdW5kYXJ5>> as group22 {
    rectangle "==Guest workload\n<size:16>[Container: Provider confinement]</size>\n\nUntrusted harness, relay and loopback listeners; no overlay membership or workload keys." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.Guestworkload
  }

  rectangle "Launch mediation boundary" <<Group-TGF1bmNoIG1lZGlhdGlvbiBib3VuZGFyeQ==>> as group23 {
    rectangle "==Agent mediator\n<size:16>[Container: Local policy enforcement]</size>\n\nEnforces this launch's policy and stamps identity; has no network access of its own." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.Agentmediator
  }

}

afakt.Guestworkload --> afakt.Agentmediator <<Relationship-UmVsYXRpb25zaGlw>> : "1: Source launch requests published destination\n<size:16>[Local provider carrier]</size>"
afakt.Agentmediator --> afakt.Agentproxy <<Relationship-UmVsYXRpb25zaGlw>> : "2: Source policy permits destination name and port\n<size:16>[Local channel]</size>"
afakt.Agentproxy --> afakt.Destinationagentproxy <<Relationship-UmVsYXRpb25zaGlwLFVuZGVjaWRlZA==>> : "3: Source and destination workload identities; route undecided\n<size:16>[Transport undecided]</size>"
afakt.Destinationagentproxy --> afakt.Destinationmediator <<Relationship-UmVsYXRpb25zaGlw>> : "4: Authenticated source launch and destination grant\n<size:16>[Local channel]</size>"
afakt.Destinationmediator --> afakt.Destinationguest <<Relationship-UmVsYXRpb25zaGlw>> : "5: Check current publication and grant before listener access\n<size:16>[Local provider carrier]</size>"

@enduml
