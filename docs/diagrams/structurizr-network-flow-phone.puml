@startuml
title <size:24>Dynamic View: afakt</size>\n<size:24>Phone reaches the dashboard through an attached user tailnet.</size>

set separator none
left to right direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

skinparam {
  nodesep 80
  ranksep 160
}

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Topology
  .Element-RWxlbWVudCxUb3BvbG9neQ== {
    BackgroundColor: #e8f1fa;
    LineColor: #315b7d;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #122b44;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // afakt
  .Boundary-YWZha3Q= {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Control plane services
  .Group-Q29udHJvbCBwbGFuZSBzZXJ2aWNlcw== {
    BackgroundColor: #ffffff;
    LineColor: #536b7e;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // External ingress boundary
  .Group-RXh0ZXJuYWwgaW5ncmVzcyBib3VuZGFyeQ== {
    BackgroundColor: #ffffff;
    LineColor: #536b7e;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "afakt\n<size:16>[Software System]</size>" <<Boundary-YWZha3Q=>> {
  rectangle "Control plane services" <<Group-Q29udHJvbCBwbGFuZSBzZXJ2aWNlcw==>> as group16 {
    rectangle "==API server and web dashboard\n<size:16>[Container: Application service]</size>\n\nAuthorizes workload creation using workload templates and workload images; serves the dashboard from its own origin." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.APIserverandwebdashboard
  }

  rectangle "External ingress boundary" <<Group-RXh0ZXJuYWwgaW5ncmVzcyBib3VuZGFyeQ==>> as group17 {
    rectangle "==External ingress gateway\n<size:16>[Container: Application proxy]</size>\n\nAccepts public and attached-tailnet application requests; never routes packets between tailnets and the cluster." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.Externalingressgateway
  }

}

rectangle "==Phone and native clients\n<size:16>[Software System]</size>\n\nOperator devices using their attached user tailnet and afakt sign-in." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Phoneandnativeclients
rectangle "==Attached user tailnet\n<size:16>[Software System]</size>\n\nUser-controlled private connectivity; separate from the cluster overlay." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Attachedusertailnet

Phoneandnativeclients --> Attachedusertailnet <<Relationship-UmVsYXRpb25zaGlw>> : "1: Device identity in user-owned network\n<size:16>[User tailnet]</size>"
Attachedusertailnet --> afakt.Externalingressgateway <<Relationship-UmVsYXRpb25zaGlw>> : "2: Private application request; afakt sign-in\n<size:16>[Transport Layer Security]</size>"
afakt.Externalingressgateway --> afakt.APIserverandwebdashboard <<Relationship-UmVsYXRpb25zaGlw>> : "3: Authenticated user context to web dashboard; no packet routing\n<size:16>[Application protocol over overlay]</size>"

@enduml
