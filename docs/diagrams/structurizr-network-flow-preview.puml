@startuml
title <size:24>Dynamic View: afakt</size>\n<size:24>Operator browser reaches a preview through the host node.</size>

set separator none
top to bottom direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

skinparam {
  nodesep 80
  ranksep 160
}

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Topology
  .Element-RWxlbWVudCxUb3BvbG9neQ== {
    BackgroundColor: #e8f1fa;
    LineColor: #315b7d;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #122b44;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // afakt
  .Boundary-YWZha3Q= {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Control plane services
  .Group-Q29udHJvbCBwbGFuZSBzZXJ2aWNlcw== {
    BackgroundColor: #ffffff;
    LineColor: #536b7e;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Host management boundary
  .Group-SG9zdCBtYW5hZ2VtZW50IGJvdW5kYXJ5 {
    BackgroundColor: #ffffff;
    LineColor: #536b7e;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Launch guest boundary
  .Group-TGF1bmNoIGd1ZXN0IGJvdW5kYXJ5 {
    BackgroundColor: #ffffff;
    LineColor: #536b7e;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Launch mediation boundary
  .Group-TGF1bmNoIG1lZGlhdGlvbiBib3VuZGFyeQ== {
    BackgroundColor: #ffffff;
    LineColor: #536b7e;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Launch workload proxy boundary
  .Group-TGF1bmNoIHdvcmtsb2FkIHByb3h5IGJvdW5kYXJ5 {
    BackgroundColor: #ffffff;
    LineColor: #536b7e;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Operator access on the workload host
  .Group-T3BlcmF0b3IgYWNjZXNzIG9uIHRoZSB3b3JrbG9hZCBob3N0 {
    BackgroundColor: #ffffff;
    LineColor: #536b7e;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "afakt\n<size:16>[Software System]</size>" <<Boundary-YWZha3Q=>> {
  rectangle "Control plane services" <<Group-Q29udHJvbCBwbGFuZSBzZXJ2aWNlcw==>> as group11 {
    rectangle "==Preview server\n<size:16>[Container: Application service]</size>\n\nDials workload proxies over the overlay; published-port listener binding remains open." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.Previewserver
  }

  rectangle "Host management boundary" <<Group-SG9zdCBtYW5hZ2VtZW50IGJvdW5kYXJ5>> as group12 {
    rectangle "==Host name resolver\n<size:16>[Container: Domain Name System]</size>\n\nResolves names under *.afakt.internal for host clients." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.Hostnameresolver
  }

  rectangle "Launch guest boundary" <<Group-TGF1bmNoIGd1ZXN0IGJvdW5kYXJ5>> as group13 {
    rectangle "==Guest context\n<size:16>[Container: Workload provider confinement]</size>\n\nUntrusted harness, relay and loopback listeners; no overlay membership or workload keys." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.Guestcontext
  }

  rectangle "Launch mediation boundary" <<Group-TGF1bmNoIG1lZGlhdGlvbiBib3VuZGFyeQ==>> as group14 {
    rectangle "==Workload proxy mediator\n<size:16>[Container: Local policy enforcement]</size>\n\nDecides every inbound and outbound connection and stamps identity; never carries traffic." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.Workloadproxymediator
  }

  rectangle "Launch workload proxy boundary" <<Group-TGF1bmNoIHdvcmtsb2FkIHByb3h5IGJvdW5kYXJ5>> as group15 {
    rectangle "==Workload proxy\n<size:16>[Container: Network proxy]</size>\n\nCarries workload traffic in both directions; own overlay node and launch X.509-SVID; asks the mediator to decide each connection." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.Workloadproxy
  }

  rectangle "Operator access on the workload host" <<Group-T3BlcmF0b3IgYWNjZXNzIG9uIHRoZSB3b3JrbG9hZCBob3N0>> as group16 {
    rectangle "==Host access boundary\n<size:16>[Container: Access mechanism undecided]</size>\n\nHost-level authorization for services, previews and ports; local caller and connection mechanisms undecided." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.Hostaccessboundary
    rectangle "==Host-level connectivity\n<size:16>[Container: Host connectivity service]</size>\n\nHost authorization for agent and cluster services; connection mechanism undecided; optional user tailnet attachment." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.Hostlevelconnectivity
  }

}

rectangle "==Operator browser\n<size:16>[Software System]</size>\n\nA browser under the operator's local user identity." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Operatorbrowser

Operatorbrowser --> afakt.Hostnameresolver <<Relationship-UmVsYXRpb25zaGlw>> : "1: Resolve internal preview name\n<size:16>[Local name query]</size>"
Operatorbrowser --> afakt.Hostaccessboundary <<Relationship-UmVsYXRpb25zaGlw>> : "2: Host access request; mechanism undecided\n<size:16>[Host access mechanism undecided]</size>"
afakt.Hostaccessboundary --> afakt.Hostlevelconnectivity <<Relationship-UmVsYXRpb25zaGlw>> : "3: Request under host-level authorization\n<size:16>[Connection mechanism undecided]</size>"
afakt.Hostlevelconnectivity --> afakt.Previewserver <<Relationship-UmVsYXRpb25zaGlw>> : "4: Host workload identity; served app may require its own sign-in\n<size:16>[Workload mutual TLS over overlay]</size>"
afakt.Previewserver --> afakt.Workloadproxy <<Relationship-UmVsYXRpb25zaGlw>> : "5: Direct overlay connection; mutual SPIFFE authentication\n<size:16>[SPIFFE mutual TLS over overlay]</size>"
afakt.Workloadproxy --> afakt.Workloadproxymediator <<Relationship-UmVsYXRpb25zaGlw>> : "6: Request decision for caller and publication\n<size:16>[Local channel]</size>"
afakt.Workloadproxymediator --> afakt.Workloadproxy <<Relationship-UmVsYXRpb25zaGlw>> : "7: Return decision; publication binding remains open\n<size:16>[Local channel]</size>"
afakt.Workloadproxy --> afakt.Guestcontext <<Relationship-UmVsYXRpb25zaGlw>> : "8: Permitted ingress; listener binding open (OQ-PORT-14)\n<size:16>[Private workload link]</size>"

@enduml
