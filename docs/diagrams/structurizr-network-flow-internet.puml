@startuml
title <size:24>Dynamic View: afakt</size>\n<size:24>Guest egress through its proxy under mediator decisions.</size>

set separator none
left to right direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

skinparam {
  nodesep 80
  ranksep 160
}

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Topology
  .Element-RWxlbWVudCxUb3BvbG9neQ== {
    BackgroundColor: #e8f1fa;
    LineColor: #315b7d;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #122b44;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // afakt
  .Boundary-YWZha3Q= {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Launch guest boundary
  .Group-TGF1bmNoIGd1ZXN0IGJvdW5kYXJ5 {
    BackgroundColor: #ffffff;
    LineColor: #536b7e;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Launch mediation boundary
  .Group-TGF1bmNoIG1lZGlhdGlvbiBib3VuZGFyeQ== {
    BackgroundColor: #ffffff;
    LineColor: #536b7e;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Launch workload proxy boundary
  .Group-TGF1bmNoIHdvcmtsb2FkIHByb3h5IGJvdW5kYXJ5 {
    BackgroundColor: #ffffff;
    LineColor: #536b7e;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "afakt\n<size:16>[Software System]</size>" <<Boundary-YWZha3Q=>> {
  rectangle "Launch guest boundary" <<Group-TGF1bmNoIGd1ZXN0IGJvdW5kYXJ5>> as group4 {
    rectangle "==Guest context\n<size:16>[Container: Workload provider confinement]</size>\n\nUntrusted harness, relay and loopback listeners; no overlay membership or workload keys." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.Guestcontext
  }

  rectangle "Launch mediation boundary" <<Group-TGF1bmNoIG1lZGlhdGlvbiBib3VuZGFyeQ==>> as group5 {
    rectangle "==Workload proxy mediator\n<size:16>[Container: Local policy enforcement]</size>\n\nDecides every inbound and outbound connection and stamps identity; never carries traffic." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.Workloadproxymediator
  }

  rectangle "Launch workload proxy boundary" <<Group-TGF1bmNoIHdvcmtsb2FkIHByb3h5IGJvdW5kYXJ5>> as group6 {
    rectangle "==Workload proxy\n<size:16>[Container: Network proxy]</size>\n\nCarries workload traffic in both directions; own overlay node and launch X.509-SVID; asks the mediator to decide each connection." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.Workloadproxy
  }

}

rectangle "==Internet services\n<size:16>[Software System]</size>\n\nPermitted upstream destinations outside the cluster trust domain." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Internetservices

afakt.Guestcontext --> afakt.Workloadproxy <<Relationship-UmVsYXRpb25zaGlw>> : "1: Traffic on private workload link; no guest workload key\n<size:16>[Private workload link]</size>"
afakt.Workloadproxy --> afakt.Workloadproxymediator <<Relationship-UmVsYXRpb25zaGlw>> : "2: Request destination decision\n<size:16>[Local channel]</size>"
afakt.Workloadproxymediator --> afakt.Workloadproxy <<Relationship-UmVsYXRpb25zaGlw>> : "3: Permit destination; instruct proxy TLS termination when required\n<size:16>[Local channel]</size>"
afakt.Workloadproxy --> Internetservices <<Relationship-UmVsYXRpb25zaGlw>> : "4: Permitted request; destination credentials when authorized\n<size:16>[Destination protocol]</size>"

@enduml
