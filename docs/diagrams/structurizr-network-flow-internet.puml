@startuml
title <size:24>Dynamic View: afakt</size>\n<size:24>Guest egress through its mediator and agent proxy.</size>

set separator none
left to right direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

skinparam {
  nodesep 80
  ranksep 160
}

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Topology
  .Element-RWxlbWVudCxUb3BvbG9neQ== {
    BackgroundColor: #e8f1fa;
    LineColor: #315b7d;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #122b44;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // afakt
  .Boundary-YWZha3Q= {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Launch agent proxy boundary
  .Group-TGF1bmNoIGFnZW50IHByb3h5IGJvdW5kYXJ5 {
    BackgroundColor: #ffffff;
    LineColor: #536b7e;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Launch guest boundary
  .Group-TGF1bmNoIGd1ZXN0IGJvdW5kYXJ5 {
    BackgroundColor: #ffffff;
    LineColor: #536b7e;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Launch mediation boundary
  .Group-TGF1bmNoIG1lZGlhdGlvbiBib3VuZGFyeQ== {
    BackgroundColor: #ffffff;
    LineColor: #536b7e;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "afakt\n<size:16>[Software System]</size>" <<Boundary-YWZha3Q=>> {
  rectangle "Launch agent proxy boundary" <<Group-TGF1bmNoIGFnZW50IHByb3h5IGJvdW5kYXJ5>> as group3 {
    rectangle "==Agent proxy\n<size:16>[Container: Tailscale tsnet]</size>\n\nOwn overlay node, hub connection and launch X.509-SVID; only launch component opening connections off the host." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.Agentproxy
  }

  rectangle "Launch guest boundary" <<Group-TGF1bmNoIGd1ZXN0IGJvdW5kYXJ5>> as group4 {
    rectangle "==Guest workload\n<size:16>[Container: Provider confinement]</size>\n\nUntrusted harness, relay and loopback listeners; no overlay membership or workload keys." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.Guestworkload
  }

  rectangle "Launch mediation boundary" <<Group-TGF1bmNoIG1lZGlhdGlvbiBib3VuZGFyeQ==>> as group5 {
    rectangle "==Agent mediator\n<size:16>[Container: Local policy enforcement]</size>\n\nEnforces this launch's policy and stamps identity; has no network access of its own." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.Agentmediator
  }

}

rectangle "==Internet services\n<size:16>[Software System]</size>\n\nPermitted upstream destinations outside the cluster trust domain." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Internetservices

afakt.Guestworkload --> afakt.Agentmediator <<Relationship-UmVsYXRpb25zaGlw>> : "1: Launch-bound request; no guest workload key\n<size:16>[Local provider carrier]</size>"
afakt.Agentmediator --> afakt.Agentproxy <<Relationship-UmVsYXRpb25zaGlw>> : "2: Policy-permitted destination; inspection required for credentialed traffic\n<size:16>[Local channel]</size>"
afakt.Agentproxy --> Internetservices <<Relationship-UmVsYXRpb25zaGlw>> : "3: Permitted request; destination credentials when authorized\n<size:16>[Destination protocol]</size>"

@enduml
