@startuml
title <size:24>Deployment View: Topology context</size>\n<size:24>Operator devices, attached tailnets, cluster and internet trust boundaries.</size>

set separator none
left to right direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

skinparam {
  nodesep 80
  ranksep 160
}

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element
  .Element-RWxlbWVudA== {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Element,Deployment Node
  .DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU= {
    BackgroundColor: #f5f7fa;
    LineColor: #536b7e;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "Operator device boundary\n<size:16>[Deployment Node: Client devices]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologycontext.Operatordeviceboundary {
  rectangle "==Browser, phone, tablet and native apps\n<size:16>[Infrastructure Node: Application clients]</size>\n\nOperator and device identities." <<Element-RWxlbWVudA==>> as Topologycontext.Operatordeviceboundary.Browserphonetabletandnativeapps
}

rectangle "User tailnet boundary\n<size:16>[Deployment Node: User network]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologycontext.Usertailnetboundary {
  rectangle "==Attached user tailnets\n<size:16>[Infrastructure Node: Tailscale]</size>\n\nPrivate application access to attached gateways." <<Element-RWxlbWVudA==>> as Topologycontext.Usertailnetboundary.Attachedusertailnets
}

rectangle "Cluster trust domain\n<size:16>[Deployment Node: Private cluster]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologycontext.Clustertrustdomain {
  rectangle "External ingress boundary\n<size:16>[Deployment Node: Gateway node]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologycontext.Clustertrustdomain.Externalingressboundary {
    rectangle "==External ingress gateway\n<size:16>[Infrastructure Node: Application proxy]</size>\n\nPublic and user-tailnet application traffic; no packet routing." <<Element-RWxlbWVudA==>> as Topologycontext.Clustertrustdomain.Externalingressboundary.Externalingressgateway
  }

  rectangle "==Control plane and agent hosts\n<size:16>[Infrastructure Node: Isolated Headscale overlay]</size>\n\nPer-service, per-host and per-launch nodes; guests have no overlay membership." <<Element-RWxlbWVudA==>> as Topologycontext.Clustertrustdomain.Controlplaneandagenthosts
}

rectangle "Internet boundary\n<size:16>[Deployment Node: External network]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologycontext.Internetboundary {
  rectangle "==Internet services\n<size:16>[Infrastructure Node: Destination services]</size>\n\nOnly permitted egress leaves an agent host." <<Element-RWxlbWVudA==>> as Topologycontext.Internetboundary.Internetservices
}

Topologycontext.Operatordeviceboundary.Browserphonetabletandnativeapps --> Topologycontext.Usertailnetboundary.Attachedusertailnets <<Relationship-UmVsYXRpb25zaGlw>> : "Device identity\n<size:16>[User tailnet]</size>"
Topologycontext.Operatordeviceboundary.Browserphonetabletandnativeapps --> Topologycontext.Clustertrustdomain.Externalingressboundary.Externalingressgateway <<Relationship-UmVsYXRpb25zaGlw>> : "Signed-in user\n<size:16>[Public application request]</size>"
Topologycontext.Usertailnetboundary.Attachedusertailnets --> Topologycontext.Clustertrustdomain.Externalingressboundary.Externalingressgateway <<Relationship-UmVsYXRpb25zaGlw>> : "User context; no packet routing\n<size:16>[Private application request]</size>"
Topologycontext.Clustertrustdomain.Externalingressboundary.Externalingressgateway --> Topologycontext.Clustertrustdomain.Controlplaneandagenthosts <<Relationship-UmVsYXRpb25zaGlw>> : "Authenticated application request\n<size:16>[Cluster overlay]</size>"
Topologycontext.Clustertrustdomain.Controlplaneandagenthosts --> Topologycontext.Internetboundary.Internetservices <<Relationship-UmVsYXRpb25zaGlw>> : "Permitted destination request\n<size:16>[Agent proxy egress]</size>"

@enduml
