@startuml
title <size:24>Deployment View: Topology launch</size>\n<size:24>One launch crosses guest, mediation, network and service boundaries.</size>

set separator none
left to right direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

skinparam {
  nodesep 80
  ranksep 160
}

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Topology
  .Element-RWxlbWVudCxUb3BvbG9neQ== {
    BackgroundColor: #e8f1fa;
    LineColor: #315b7d;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #122b44;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Element,Deployment Node
  .DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU= {
    BackgroundColor: #f5f7fa;
    LineColor: #536b7e;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "Workload host trust boundary\n<size:16>[Deployment Node: Workload host]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologylaunch.Workloadhosttrustboundary {
  rectangle "Agent launch boundary\n<size:16>[Deployment Node: Launch isolation]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologylaunch.Workloadhosttrustboundary.Agentlaunchboundary {
    rectangle "Guest trust boundary\n<size:16>[Deployment Node: Workload provider confinement]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologylaunch.Workloadhosttrustboundary.Agentlaunchboundary.Guesttrustboundary {
      rectangle "==Guest context\n<size:16>[Container: Workload provider confinement]</size>\n\nUntrusted harness, relay and loopback listeners; no overlay membership or workload keys." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Topologylaunch.Workloadhosttrustboundary.Agentlaunchboundary.Guesttrustboundary.Guestcontext_1
    }

    rectangle "Mediation trust boundary\n<size:16>[Deployment Node: Local confinement; user undecided]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologylaunch.Workloadhosttrustboundary.Agentlaunchboundary.Mediationtrustboundary {
      rectangle "==Workload proxy mediator\n<size:16>[Container: Local policy enforcement]</size>\n\nDecides every inbound and outbound connection and stamps identity; never carries traffic." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Topologylaunch.Workloadhosttrustboundary.Agentlaunchboundary.Mediationtrustboundary.Workloadproxymediator_1
    }

    rectangle "Workload proxy trust boundary\n<size:16>[Deployment Node: tsnet node; user undecided]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologylaunch.Workloadhosttrustboundary.Agentlaunchboundary.Workloadproxytrustboundary {
      rectangle "==Workload proxy\n<size:16>[Container: Network proxy]</size>\n\nCarries workload traffic in both directions; own overlay node and launch X.509-SVID; asks the mediator to decide each connection." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Topologylaunch.Workloadhosttrustboundary.Agentlaunchboundary.Workloadproxytrustboundary.Workloadproxy_1
    }

  }

}

rectangle "Control plane trust boundary\n<size:16>[Deployment Node: Cluster overlay]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologylaunch.Controlplanetrustboundary {
  rectangle "API service node\n<size:16>[Deployment Node: tsnet node]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologylaunch.Controlplanetrustboundary.APIservicenode {
    rectangle "==API server and web dashboard\n<size:16>[Container: Application service]</size>\n\nAuthorizes workload creation using workload templates and workload images; serves the dashboard from its own origin." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Topologylaunch.Controlplanetrustboundary.APIservicenode.APIserverandwebdashboard_1
  }

}

rectangle "Internet boundary\n<size:16>[Deployment Node: External services]</size>" <<DeploymentNode-RWxlbWVudCxEZXBsb3ltZW50IE5vZGU=>> as Topologylaunch.Internetboundary {
  rectangle "==Internet services\n<size:16>[Software System]</size>\n\nPermitted upstream destinations outside the cluster trust domain." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Topologylaunch.Internetboundary.Internetservices_1
}

Topologylaunch.Workloadhosttrustboundary.Agentlaunchboundary.Guesttrustboundary.Guestcontext_1 --> Topologylaunch.Workloadhosttrustboundary.Agentlaunchboundary.Workloadproxytrustboundary.Workloadproxy_1 <<Relationship-UmVsYXRpb25zaGlw>> : "Sends workload traffic including DNS, TCP, UDP and QUIC\n<size:16>[Private workload link]</size>"
Topologylaunch.Workloadhosttrustboundary.Agentlaunchboundary.Mediationtrustboundary.Workloadproxymediator_1 --> Topologylaunch.Workloadhosttrustboundary.Agentlaunchboundary.Workloadproxytrustboundary.Workloadproxy_1 <<Relationship-UmVsYXRpb25zaGlw>> : "Returns connection decision and stamped launch identity\n<size:16>[Local channel]</size>"
Topologylaunch.Workloadhosttrustboundary.Agentlaunchboundary.Workloadproxytrustboundary.Workloadproxy_1 --> Topologylaunch.Controlplanetrustboundary.APIservicenode.APIserverandwebdashboard_1 <<Relationship-UmVsYXRpb25zaGlw>> : "Calls authorized operations with launch X.509-SVID\n<size:16>[Workload mutual TLS over overlay]</size>"
Topologylaunch.Workloadhosttrustboundary.Agentlaunchboundary.Workloadproxytrustboundary.Workloadproxy_1 --> Topologylaunch.Internetboundary.Internetservices_1 <<Relationship-UmVsYXRpb25zaGlw>> : "Opens permitted egress; inspection where required\n<size:16>[Destination protocol]</size>"

@enduml
