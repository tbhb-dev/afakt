@startuml
title <size:24>Dynamic View: afakt</size>\n<size:24>A browser requests a static site through the external ingress gateway.</size>

set separator none
left to right direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

skinparam {
  nodesep 80
  ranksep 160
}

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Topology
  .Element-RWxlbWVudCxUb3BvbG9neQ== {
    BackgroundColor: #e8f1fa;
    LineColor: #315b7d;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #122b44;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // afakt
  .Boundary-YWZha3Q= {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Control plane services
  .Group-Q29udHJvbCBwbGFuZSBzZXJ2aWNlcw== {
    BackgroundColor: #ffffff;
    LineColor: #536b7e;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // External ingress boundary
  .Group-RXh0ZXJuYWwgaW5ncmVzcyBib3VuZGFyeQ== {
    BackgroundColor: #ffffff;
    LineColor: #536b7e;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #182c3e;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "afakt\n<size:16>[Software System]</size>" <<Boundary-YWZha3Q=>> {
  rectangle "Control plane services" <<Group-Q29udHJvbCBwbGFuZSBzZXJ2aWNlcw==>> as group18 {
    rectangle "==Static origin\n<size:16>[Container: Caddy]</size>\n\nServes static site and single-page app deploys from local copies of their files; keeps no cache." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.Staticorigin
  }

  rectangle "External ingress boundary" <<Group-RXh0ZXJuYWwgaW5ncmVzcyBib3VuZGFyeQ==>> as group19 {
    rectangle "==External ingress gateway\n<size:16>[Container: Application proxy]</size>\n\nAccepts public and attached-tailnet application requests; never routes packets between tailnets and the cluster." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as afakt.Externalingressgateway
  }

}

rectangle "==Operator browser\n<size:16>[Software System]</size>\n\nA browser under the operator's local user identity." <<Element-RWxlbWVudCxUb3BvbG9neQ==>> as Operatorbrowser

Operatorbrowser --> afakt.Externalingressgateway <<Relationship-UmVsYXRpb25zaGlw>> : "1: Public request for a static site hostname\n<size:16>[Transport Layer Security]</size>"
afakt.Externalingressgateway --> afakt.Staticorigin <<Relationship-UmVsYXRpb25zaGlw>> : "2: Hostname mapped to the active deploy; gateway compresses and caches\n<size:16>[Application protocol over overlay]</size>"

@enduml
