@startuml
title <size:24>Component View: afakt - afakt process</size>\n<size:24>The components inside the combined afakt process.</size>

set separator none
left to right direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

skinparam {
  nodesep 80
  ranksep 160
}

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element
  .Element-RWxlbWVudA== {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // afakt
  .Boundary-YWZha3Q= {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // afakt process
  .Boundary-YWZha3QgcHJvY2Vzcw== {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "==Developer or tester\n<size:16>[Person]</size>\n\nRuns afakt and inspects its workflows." <<Element-RWxlbWVudA==>> as Developerortester

rectangle "==GitHub\n<size:16>[Software System]</size>\n\nDelivers webhooks and exposes the GitHub API." <<Element-RWxlbWVudA==>> as GitHub
rectangle "==Native apps\n<size:16>[Software System]</size>\n\nClients of afakt's REST API." <<Element-RWxlbWVudA==>> as Nativeapps
rectangle "==AI coding agents\n<size:16>[Software System]</size>\n\nPerform coding work started by Agent runner." <<Element-RWxlbWVudA==>> as AIcodingagents
rectangle "==External Temporal\n<size:16>[Software System]</size>\n\nProvides durable execution when workers use an external server." <<Element-RWxlbWVudA==>> as ExternalTemporal

rectangle "afakt\n<size:16>[Software System]</size>" <<Boundary-YWZha3Q=>> {
  rectangle "afakt process\n<size:16>[Container: Go]</size>" <<Boundary-YWZha3QgcHJvY2Vzcw==>> {
    rectangle "==GitHub webhook receiver\n<size:16>[Component: Go]</size>\n\nAccepts webhook deliveries and starts coordination work." <<Element-RWxlbWVudA==>> as afakt.afaktprocess.GitHubwebhookreceiver
    rectangle "==Web dashboard\n<size:16>[Component: React]</size>\n\nProvides the web UI from the API's origin." <<Element-RWxlbWVudA==>> as afakt.afaktprocess.Webdashboard
    rectangle "==Embedded workflow orchestrator\n<size:16>[Component: Temporal]</size>\n\nProvides durable execution inside the process for development and tests." <<Element-RWxlbWVudA==>> as afakt.afaktprocess.Embeddedworkfloworchestrator
    rectangle "==Coordination workflows\n<size:16>[Component: Temporal]</size>\n\nCoordinate work on workers inside the binary and start other workflows." <<Element-RWxlbWVudA==>> as afakt.afaktprocess.Coordinationworkflows
    rectangle "==Agent runner\n<size:16>[Component: Temporal]</size>\n\nRuns AI coding agents as a workflow." <<Element-RWxlbWVudA==>> as afakt.afaktprocess.Agentrunner
    rectangle "==Temporal Web UI\n<size:16>[Component: Temporal]</size>\n\nShows the embedded server's namespaces, workflows, and histories." <<Element-RWxlbWVudA==>> as afakt.afaktprocess.TemporalWebUI
    rectangle "==Command-line interface\n<size:16>[Component: Go]</size>\n\nRuns server services and communicates with the API." <<Element-RWxlbWVudA==>> as afakt.afaktprocess.Commandlineinterface
    rectangle "==API server\n<size:16>[Component: Go]</size>\n\nServes the REST API and starts workflows." <<Element-RWxlbWVudA==>> as afakt.afaktprocess.APIserver
  }

}

Developerortester --> afakt.afaktprocess.Commandlineinterface <<Relationship-UmVsYXRpb25zaGlw>> : "Runs commands\n<size:16>[CLI]</size>"
Developerortester --> afakt.afaktprocess.Webdashboard <<Relationship-UmVsYXRpb25zaGlw>> : "Uses the dashboard\n<size:16>[HTTP]</size>"
Developerortester --> afakt.afaktprocess.TemporalWebUI <<Relationship-UmVsYXRpb25zaGlw>> : "Inspects workflows\n<size:16>[HTTP]</size>"
Nativeapps --> afakt.afaktprocess.APIserver <<Relationship-UmVsYXRpb25zaGlw>> : "Calls the REST API\n<size:16>[HTTP]</size>"
afakt.afaktprocess.Commandlineinterface --> afakt.afaktprocess.APIserver <<Relationship-UmVsYXRpb25zaGlw>> : "Calls the REST API\n<size:16>[HTTP]</size>"
afakt.afaktprocess.Webdashboard --> afakt.afaktprocess.APIserver <<Relationship-UmVsYXRpb25zaGlw>> : "Calls the REST API\n<size:16>[HTTP]</size>"
GitHub --> afakt.afaktprocess.GitHubwebhookreceiver <<Relationship-UmVsYXRpb25zaGlw>> : "Delivers webhooks\n<size:16>[HTTP]</size>"
afakt.afaktprocess.GitHubwebhookreceiver --> afakt.afaktprocess.APIserver <<Relationship-UmVsYXRpb25zaGlw>> : "Calls the REST API\n<size:16>[HTTP]</size>"
afakt.afaktprocess.GitHubwebhookreceiver --> afakt.afaktprocess.Embeddedworkfloworchestrator <<Relationship-UmVsYXRpb25zaGlw>> : "Starts workflows in embedded mode\n<size:16>[Temporal]</size>"
afakt.afaktprocess.GitHubwebhookreceiver --> ExternalTemporal <<Relationship-UmVsYXRpb25zaGlw>> : "Starts workflows in external mode\n<size:16>[Temporal]</size>"
afakt.afaktprocess.APIserver --> afakt.afaktprocess.Embeddedworkfloworchestrator <<Relationship-UmVsYXRpb25zaGlw>> : "Starts workflows in embedded mode\n<size:16>[Temporal]</size>"
afakt.afaktprocess.APIserver --> ExternalTemporal <<Relationship-UmVsYXRpb25zaGlw>> : "Starts workflows in external mode\n<size:16>[Temporal]</size>"
afakt.afaktprocess.APIserver --> GitHub <<Relationship-UmVsYXRpb25zaGlw>> : "Calls the GitHub API\n<size:16>[HTTP]</size>"
afakt.afaktprocess.Coordinationworkflows --> afakt.afaktprocess.APIserver <<Relationship-UmVsYXRpb25zaGlw>> : "Calls the REST API\n<size:16>[HTTP]</size>"
afakt.afaktprocess.Coordinationworkflows --> GitHub <<Relationship-UmVsYXRpb25zaGlw>> : "Calls the GitHub API\n<size:16>[HTTP]</size>"
afakt.afaktprocess.Coordinationworkflows --> afakt.afaktprocess.Embeddedworkfloworchestrator <<Relationship-UmVsYXRpb25zaGlw>> : "Uses durable execution in embedded mode\n<size:16>[Temporal]</size>"
afakt.afaktprocess.Coordinationworkflows --> ExternalTemporal <<Relationship-UmVsYXRpb25zaGlw>> : "Uses durable execution in external mode\n<size:16>[Temporal]</size>"
afakt.afaktprocess.Coordinationworkflows --> afakt.afaktprocess.Agentrunner <<Relationship-UmVsYXRpb25zaGlw>> : "Starts agent work\n<size:16>[Temporal]</size>"
afakt.afaktprocess.Agentrunner --> AIcodingagents <<Relationship-UmVsYXRpb25zaGlw>> : "Runs coding agents\n<size:16>[Process]</size>"
afakt.afaktprocess.TemporalWebUI --> afakt.afaktprocess.Embeddedworkfloworchestrator <<Relationship-UmVsYXRpb25zaGlw>> : "Reads namespaces and workflow histories\n<size:16>[Temporal]</size>"

@enduml
