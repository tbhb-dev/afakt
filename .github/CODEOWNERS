# Review routing for afakt. This file names only files where every change
# needs the owner, so it has no catch-all rule. Changes where only part of
# a file is sensitive, as with the workflows, are held through owner_paths
# in .agents/agent-skills.conf instead.

/.github/CODEOWNERS           @tbhb
/.github/rulesets/            @tbhb
/.agents/agent-skills.conf    @tbhb
/.claude/settings*.json       @tbhb
/.codex/config.toml           @tbhb
