{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The repository-level policy comes from two shared devtools presets:
  // renovate-config.json5 has the rules, grouping, and the custom managers
  // for pin sites no built-in manager reads, and renovate-go-config.json5
  // has the Go-module specifics (gomodTidy and the go-deps grouping). Both
  // are pinned to the same commit. devtools:check-pins reads the trailing
  // version comment on each line, and devtools:update-pins moves both
  // together with the other pin sites.
  //
  // The global-only options (identity, limits, requireConfig) are inlined
  // here rather than taken from globalExtends, which Renovate resolves
  // before host rules exist, so that fetch would run unauthenticated.
  requireConfig: "ignored",
  username: "tbhb-dev-renovate[bot]",
  gitAuthor: "tbhb-dev-renovate[bot] <289255489+tbhb-dev-renovate[bot]@users.noreply.github.com>",
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
  extends: [
    "github>tbhb-dev/devtools//.github/renovate-config.json5#d41369e7fd0c84a878991c84a305af1d721e6305", // v0.21.0
    "github>tbhb-dev/devtools//.github/renovate-go-config.json5#d41369e7fd0c84a878991c84a305af1d721e6305", // v0.21.0
  ],

  // After a tool bump, the mise manager runs `mise lock` with whatever mise
  // containerbase installs, and with no constraint that is the newest
  // release. mise releases write mise.lock differently, and the pinned mise
  // rewrites a lockfile a newer one wrote on its next `mise install`, which
  // leaves bootstrap with a dirty tree. Holding the lockfile step to the
  // mise that `.github/workflows/ci.yml` pins keeps Renovate's output in
  // the form CI and bootstrap write. The custom manager and the package
  // rule below move this pin in the same github-actions pull request as
  // the CI pins.
  constraints: {
    // renovate: datasource=github-releases depName=jdx/mise
    mise: "2026.10.15",
  },

  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^\\.github/renovate\\.json5$/"],
      matchStrings: [
        "//\\s*renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+mise: \"(?<currentValue>[^\"]+)\"",
      ],
    },
  ],

  packageRules: [
    {
      matchFileNames: [".github/renovate.json5"],
      matchPackageNames: ["jdx/mise"],
      groupName: "github-actions",
    },
  ],

  repositories: ["tbhb-dev/afakt"],
}
