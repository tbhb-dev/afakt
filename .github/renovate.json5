{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The presets track tbhb-dev/renovate-config's main branch, pinned by
  // commit; Renovate bumps the pins (the "renovate-config" group).
  extends: [
    "github>tbhb-dev/renovate-config//default.json5#0d2cc84f85da0f0288f48eb2890077a8273d4e2e", // main
    "github>tbhb-dev/renovate-config//bazel.json5#0d2cc84f85da0f0288f48eb2890077a8273d4e2e", // main
    "github>tbhb-dev/renovate-config//go.json5#0d2cc84f85da0f0288f48eb2890077a8273d4e2e", // main
  ],

  // afakt needs nothing beyond the presets: its Go module and Bazel pins
  // are both covered there.
}
