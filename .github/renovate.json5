{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The presets track tbhb-dev/renovate-config's main branch, pinned by
  // commit; Renovate bumps the pins (the "renovate-config" group).
  extends: [
    "github>tbhb-dev/renovate-config//default.json5#d75a236e49aa0a5227598e22b2b1e365457c6b70", // main
    "github>tbhb-dev/renovate-config//bazel.json5#d75a236e49aa0a5227598e22b2b1e365457c6b70", // main
    "github>tbhb-dev/renovate-config//go.json5#d75a236e49aa0a5227598e22b2b1e365457c6b70", // main
  ],

  // afakt needs nothing beyond the presets: its Go module and Bazel pins
  // are both covered there.
}
