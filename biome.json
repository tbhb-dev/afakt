{
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.json",
      "**/*.jsonc",
      "**/*.json5",
      "**/*.ts",
      "**/*.tsx",
      "!vendor",
      "!dist",
      "!bin",
      "!.vale",
      "!.devtools",
      "!.config/mise/locks",
      "!.claude",
      "!apm_modules",
      "!target",
      "!tmp",
      "!spikes",
      "!logs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "assist": {
    "enabled": false
  },
  "overrides": [
    {
      "includes": ["**/*.ts", "**/*.tsx"],
      "linter": {
        "rules": {
          "a11y": "error",
          "complexity": "error",
          "correctness": "error",
          "nursery": "error",
          "performance": "error",
          "security": "error",
          "style": "error",
          "suspicious": "error"
        }
      }
    },
    {
      "includes": ["**/*.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["**/playwright.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": { "strictCase": false }
            }
          }
        }
      }
    }
  ]
}
