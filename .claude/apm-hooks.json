{
  "PostToolUse": [
    {
      "matcher": "Write|Edit|MultiEdit|Bash|apply_patch|shell|exec_command|write_to_file|replace_file_content|multi_replace_file_content|run_command",
      "hooks": [
        {
          "type": "command",
          "command": "bash \"$(git rev-parse --show-toplevel)/scripts/diagrams-hook.sh\"",
          "timeout": 300
        }
      ],
      "_apm_source": "_local/diagrams"
    }
  ],
  "PreToolUse": [
    {
      "matcher": "Write|Edit",
      "hooks": [
        {
          "type": "command",
          "command": "guard-markdown --hook",
          "timeout": 10
        }
      ],
      "_apm_source": "tbhb-dev/devtools/packages/agents/claude"
    }
  ]
}
