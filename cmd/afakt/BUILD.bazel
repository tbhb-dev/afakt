load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@tbhb_rules//repo:defs.bzl", "repo_files")

repo_files()

go_library(
    name = "afakt_lib",
    srcs = [
        "capacity.go",
        "main.go",
    ],
    importpath = "go.tbhb.dev/afakt/cmd/afakt",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/buildmeta",
        "//internal/capacity",
        "@com_github_spf13_cobra//:cobra",
    ],
)

go_binary(
    name = "afakt",
    embed = [":afakt_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "afakt_test",
    srcs = [
        "capacity_internal_test.go",
        "main_internal_test.go",
    ],
    embed = [":afakt_lib"],
    # The whole-module Go checks in the root package take the tests too.
    visibility = ["//:__pkg__"],
)
